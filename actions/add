#!/bin/bash
# Add-on da Equipe para suportar a flag -d (deadline)

shift # Pula o $1 (que é a palavra 'add')

TEM_DEADLINE=0
TAREFA_FINAL=""

# 1. Varre todos os argumentos digitados
while [[ $# -gt 0 ]]; do
    if [ "$1" == "-d" ]; then
        TEM_DEADLINE=1
        DEADLINE="$2"
        shift 2
        if [[ "$1" =~ ^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$ ]]; then
            DEADLINE_TIME="$1"
            shift
        fi
    else
        TAREFA_FINAL="$TAREFA_FINAL $1"
        shift
    fi
done

if [ "$TEM_DEADLINE" -eq 1 ]; then
    TIMESTAMP=$(date -d "$DEADLINE ${DEADLINE_TIME:-23:59:59}" +%s) || exit 1
    TAREFA_FINAL="$TAREFA_FINAL due:$TIMESTAMP"
    TODOTXT_VERBOSE=0 "$TODO_FULL_SH" command add "$TAREFA_FINAL" || exit $?

    TASKNUM=$(sed -n '$ =' "$TODO_FILE")
    TAREFA_EXIBIDA=$(sed -n "${TASKNUM}p" "$TODO_FILE")
    DATA_EXIBIDA=$(date -d "@$TIMESTAMP" +"%d/%m/%Y %H:%M") || exit 1
    TAREFA_EXIBIDA="${TAREFA_EXIBIDA//due:$TIMESTAMP/due:$DATA_EXIBIDA}"

    if [ "$TODOTXT_VERBOSE" -gt 0 ]; then
        echo "$TASKNUM $TAREFA_EXIBIDA"
        echo "$(basename "$TODO_FILE" .txt | tr '[:lower:]' '[:upper:]'): $TASKNUM added."
    fi
else
    "$TODO_FULL_SH" command add "$TAREFA_FINAL"
fi
