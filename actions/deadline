#!/bin/bash
# Uso: ./todo.sh deadline <id_task> <yyyy-mm-dd> [HH:MM[:SS]]

shift # Pula o $1 (que é a palavra 'deadline')

TASK_ID=$1
DEADLINE=$2
DEADLINE_TIME=$3

# Validação básica
if [ -z "$TASK_ID" ] || [ -z "$DEADLINE" ]; then
    echo "Uso: todo.sh deadline <Numero_da_Tarefa> <yyyy-mm-dd> [HH:MM[:SS]]"
    exit 1
fi

# 1. Checa se a tarefa (linha) existe
TOTAL_LINHAS=$(wc -l < "$TODO_FILE")
if [ "$TASK_ID" -gt "$TOTAL_LINHAS" ]; then
    echo "Erro: A tarefa $TASK_ID não existe."
    exit 1
fi

# 2. Converte a data para Timestamp Unix
if [ -n "$DEADLINE_TIME" ] && [[ ! "$DEADLINE_TIME" =~ ^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$ ]]; then
    echo "Erro: Horário inválido. Use HH:MM ou HH:MM:SS."
    exit 1
fi
TIMESTAMP=$(date -d "$DEADLINE ${DEADLINE_TIME:-23:59:59}" +%s) || exit 1
START_TIMESTAMP=$(( $(date +%s) - 3 * 60 * 60 ))

# Preserve the original start when updating an existing deadline.
CURRENT_TASK=$(sed -n "${TASK_ID}p" "$TODO_FILE")
if [[ "$CURRENT_TASK" =~ start:([0-9]+)([[:space:]]|$) ]]; then
    START_TIMESTAMP="${BASH_REMATCH[1]}"
fi

# 3. UPDATE: Remove deadline antigo (se existir)
sed -i.bak "${TASK_ID}s/ due:[0-9]*//g" "$TODO_FILE"
if ! [[ "$CURRENT_TASK" =~ start:[0-9]+([[:space:]]|$) ]]; then
    sed -i.bak "${TASK_ID}s/$/ start:$START_TIMESTAMP/" "$TODO_FILE"
fi

# 4. ADD: Adiciona o novo deadline no final da linha
sed -i.bak "${TASK_ID}s/$/ due:$TIMESTAMP/" "$TODO_FILE"


# mudar mensagem para data do deadline
echo "Deadline configurado para a tarefa $TASK_ID com sucesso! (Timestamp: $TIMESTAMP)"
